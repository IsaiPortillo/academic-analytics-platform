# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copiar a `.env` y reemplazar los valores. El archivo `.env` NO se versiona.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (motor OLTP) - usado por docker-compose y por los scripts Python
# -----------------------------------------------------------------------------
POSTGRES_DB=academico_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_este_password
POSTGRES_HOST=localhost
# Si ya tienes un PostgreSQL instalado en tu maquina ocupando el 5432, cambia
# este puerto (por ejemplo 5433): el contenedor no podra arrancar si esta tomado.
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Usuario de servicio de la aplicacion web
# Lo crea database/oltp/06_bootstrap_rol_app.sh durante el primer arranque.
# No es superusuario: solo puede cambiar a rol_coordinador o rol_docente.
# -----------------------------------------------------------------------------
APP_DB_USER=rol_app
APP_DB_PASSWORD=cambiar_este_password_de_app

# -----------------------------------------------------------------------------
# Neo4j (grafo de malla curricular)
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambiar_este_password_neo4j

# -----------------------------------------------------------------------------
# Aplicacion FastAPI
# Clave para firmar la cookie de sesion. Generar una cadena larga aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# -----------------------------------------------------------------------------
APP_SECRET_KEY=cambiar_por_una_cadena_larga_y_aleatoria
