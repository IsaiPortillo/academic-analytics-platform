# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copiar a `.env` y reemplazar los valores. El archivo `.env` NO se versiona.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (motor OLTP) - usado por docker-compose y por los scripts Python
# -----------------------------------------------------------------------------
POSTGRES_DB=academico_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_este_password
POSTGRES_HOST=localhost
# Si ya tienes un PostgreSQL instalado en tu maquina ocupando el 5432, cambia
# este puerto (por ejemplo 5433): el contenedor no podra arrancar si esta tomado.
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Usuario de servicio de la aplicacion web
# Lo crea database/oltp/06_bootstrap_rol_app.sh durante el primer arranque.
# No es superusuario: solo puede cambiar a rol_coordinador o rol_docente.
# -----------------------------------------------------------------------------
APP_DB_USER=rol_app
APP_DB_PASSWORD=cambiar_este_password_de_app

# -----------------------------------------------------------------------------
# Usuario de solo lectura del ETL (Fase 3)
# Lo habilita database/oltp/07_bootstrap_rol_etl.sh. Solo puede leer el esquema
# operacional: cualquier intento de escritura lo rechaza PostgreSQL.
# -----------------------------------------------------------------------------
ETL_DB_USER=rol_etl
ETL_DB_PASSWORD=cambiar_este_password_de_etl

# -----------------------------------------------------------------------------
# Usuario de solo lectura del dashboard (Fase 4)
# Lo habilita database/oltp/11_bootstrap_rol_dashboard.sh. Solo puede leer el
# Data Warehouse (dw_academico): PostgreSQL le niega el esquema operacional.
# -----------------------------------------------------------------------------
DASHBOARD_DB_USER=rol_dashboard
DASHBOARD_DB_PASSWORD=cambiar_este_password_de_dashboard

# -----------------------------------------------------------------------------
# Usuario de ESCRITURA del Data Warehouse (Fase 3.3, SCRUM-35)
# Lo habilita database/oltp/14_bootstrap_rol_dw_carga.sh. Solo puede cargar
# dw_academico: no puede leer ni alterar academico_oltp. Es distinto de rol_etl
# a proposito: quien lee el sistema transaccional no escribe el DW, y quien
# escribe el DW no lee el sistema transaccional.
# -----------------------------------------------------------------------------
DW_CARGA_DB_USER=rol_dw_carga
DW_CARGA_DB_PASSWORD=cambiar_este_password_de_carga_dw

# -----------------------------------------------------------------------------
# Neo4j (grafo de malla curricular)
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambiar_este_password_neo4j

# -----------------------------------------------------------------------------
# Aplicacion FastAPI
# Clave para firmar la cookie de sesion. Generar una cadena larga aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# -----------------------------------------------------------------------------
APP_SECRET_KEY=cambiar_por_una_cadena_larga_y_aleatoria

# Apagado (false) por defecto a proposito. En true, el login muestra botones
# de "acceso rapido" con credenciales reales precargadas (coordinador/docente) -
# util para una demostracion puntual (ej. defensa de tesis) en un entorno
# controlado, pero NUNCA debe quedar en true en un despliegue alcanzable desde
# internet: cualquiera con la URL podria entrar con un clic.
MODO_DEMO=false
