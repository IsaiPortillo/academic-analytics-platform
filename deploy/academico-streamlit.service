# Dashboard interactivo (Streamlit) de Sistema Minerva.
#
#   sudo cp deploy/academico-streamlit.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now academico-streamlit
#
# Escucha SOLO en 127.0.0.1:8501 y bajo /analitica/. La única puerta pública es nginx,
# que exige la sesión de un coordinador antes de dejar pasar (deploy/nginx-edumetrics.conf).
# Lee .env (DASHBOARD_DB_*): el rol rol_dashboard solo puede leer dw_academico.

[Unit]
Description=Dashboard interactivo (Streamlit) - Sistema Minerva
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/academic-analytics-platform
Environment=STREAMLIT_SERVER_BASE_URL_PATH=analitica
Environment=STREAMLIT_SERVER_ADDRESS=127.0.0.1
Environment=STREAMLIT_SERVER_PORT=8501
Environment=STREAMLIT_SERVER_HEADLESS=true
Environment=STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ExecStart=/var/www/academic-analytics-platform/.venv/bin/python -m streamlit run dashboard/app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
